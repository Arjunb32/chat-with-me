PORT=5177

# Required before first production setup.
APP_SETUP_CODE=change-this-long-random-setup-code

# Use your HTTPS domain in production.
PUBLIC_ORIGIN=https://chat.example.com

# Voice/video calls need a TURN relay in production. Choose one provider below.
# Cloudflare Realtime TURN: keep both values server-side; users receive temporary credentials.
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
# Or coturn with use-auth-secret configured on your relay:
# TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:443?transport=tcp
# TURN_SHARED_SECRET=
# Force relay candidates during cross-network verification (or to hide peers' IPs from each other).
# RTC_RELAY_ONLY=false

# Optional CSP reporting.
# CSP_REPORT_URI=/api/csp-report
# CSP_REPORT_ONLY=false

# Local default is 12 MB.
MAX_UPLOAD_MB=12

# In production behind HTTPS, use production.
NODE_ENV=development

# Local defaults.
STORE_DRIVER=json
MEDIA_DRIVER=local

# Argon2id password hashing. Requires Node 24.7+ crypto.argon2 support.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Production metadata database.
# STORE_DRIVER=postgres
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=true

# Production encrypted media storage: Cloudflare R2, AWS S3, or S3-compatible.
# MEDIA_DRIVER=s3
# S3_BUCKET=chat-with-me-private
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# S3_PREFIX=attachments
# S3_FORCE_PATH_STYLE=false
# S3_SERVER_SIDE_ENCRYPTION=

# Encrypted backups.
# BACKUP_PASSPHRASE=replace-with-a-long-random-secret
# BACKUP_DIR=backups
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=database-backups
